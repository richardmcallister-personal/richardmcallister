{
  // richardmcallister.app — static showcase, served by a Workers static-assets deployment (no Worker script).
  "name": "richardmcallister",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "richardmcallister.app", "custom_domain": true },
    { "pattern": "www.richardmcallister.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
